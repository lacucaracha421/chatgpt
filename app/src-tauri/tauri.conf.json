{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lakomics",
  "version": "0.2.0",
  "identifier": "com.lakomics.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lakomics",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: lakomics: http://lakomics.localhost https://ehgt.org https://*.ehgt.org https://*.siam-cdn.net; media-src 'self' lakomics: http://lakomics.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../character-runtime/learned_compare.py": "character-runtime/learned_compare.py",
      "../character-runtime/runtime.py": "character-runtime/runtime.py",
      "../character-runtime/baseline.json": "character-runtime/baseline.json",
      "../character-runtime/feature_cache.py": "character-runtime/feature_cache.py",
      "../character-runtime/profiling.py": "character-runtime/profiling.py",
      "../character-runtime/scan_worker.py": "character-runtime/scan_worker.py",
      "licenses/*": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
