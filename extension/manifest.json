{
  "manifest_version": 3,
  "name": "Lakomics X Collector",
  "version": "2.0.0.1554",
  "description": "Collect X media into Lakomics with server capture, radial tagging, integrated X translation, and a For You image gallery.",
  "key": "",
  "permissions": [
    "storage",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "http://127.0.0.1:32145/*",
    "http://100.76.119.29:32146/*",
    "https://lacucaracha421.github.io/*",
    "https://pbs.twimg.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://video.twimg.com/*",
    "https://*.ts.net/*",
    "https://ollama.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://ai-gateway.vercel.sh/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_title": "Lakomics X Collector 설정"
  },
  "background": {
    "service_worker": "src/background-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/x-translate.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/defaults.js",
        "src/layout.js",
        "src/gesture.js",
        "src/x-source.js",
        "src/x-gallery.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lacucaracha421.github.io/chatgpt/*"
      ],
      "js": [
        "src/mobile-library-store.js",
        "src/mobile-bridge.js",
        "src/mobile-assets.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "mobile-api-frame.html",
        "src/mobile-api-frame.js"
      ],
      "matches": [
        "https://lacucaracha421.github.io/*"
      ]
    }
  ],
  "version_name": "2.0.0-alpha.15.54",
  "options_page": "options/options.html",
  "icons": {
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  }
}
