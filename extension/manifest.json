{
  "manifest_version": 3,
  "name": "Lakomics X Collector",
  "version": "0.1.0",
  "description": "Collect X images directly into Lakomics with a radial classification menu.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:32145/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/layout.js", "src/gesture.js", "src/x-source.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
