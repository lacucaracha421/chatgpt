{
  "manifest_version": 3,
  "name": "Lakomics Collector List",
  "version": "3.0.0.8",
  "version_name": "3.0.0-alpha.8",
  "description": "A list-first Lakomics media collector.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://100.76.119.29/*"
  ],
  "action": {
    "default_title": "Lakomics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/extension-pair*"
      ],
      "js": [
        "src/pairing-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/x-translate.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/classification-tree.js",
        "src/x-source.js",
        "src/x-gallery.js",
        "src/list-collector.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://lacucaracha421.github.io/chatgpt/*",
        "https://*/extension-pair*"
      ],
      "js": [
        "src/classification-tree.js",
        "src/forum-source.js",
        "src/list-collector.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
