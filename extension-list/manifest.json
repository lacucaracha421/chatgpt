{
  "manifest_version": 3,
  "name": "Lakomics Companion",
  "version": "3.5.34",
  "description": "Collect images and videos into Lakomics, translate X posts, YouTube subtitles and web pages, and use the Lakomics right-click menu.",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "unlimitedStorage",
    "clipboardRead",
    "clipboardWrite",
    "pageCapture",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:39125/*",
    "http://100.76.119.29/*"
  ],
  "action": {
    "default_title": "Lakomics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/extension-pair*"
      ],
      "js": [
        "src/pairing-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/x-video-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/x-video-client.js",
        "src/x-translate.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/av-lookup.js",
        "src/av-send.js",
        "src/av-lookup-chip.js",
        "src/classification-tree.js",
        "src/x-source.js",
        "src/x-gallery.js",
        "src/x-home-refresh.js",
        "src/arc-collector.js",
        "src/context-menu/model.js",
        "src/context-menu/surfaces.js",
        "src/context-menu/image.js",
        "src/context-menu/page.js",
        "src/context-menu/actions.js",
        "src/context-menu/menu.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://lacucaracha421.github.io/chatgpt/*",
        "https://*/extension-pair*"
      ],
      "js": [
        "src/av-lookup.js",
        "src/av-send.js",
        "src/av-lookup-chip.js",
        "src/classification-tree.js",
        "src/forum-source.js",
        "src/arc-collector.js",
        "src/context-menu/model.js",
        "src/context-menu/surfaces.js",
        "src/context-menu/image.js",
        "src/context-menu/page.js",
        "src/context-menu/actions.js",
        "src/context-menu/menu.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/youtube/page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/youtube/asr-choice.js",
        "src/youtube/source-pref.js",
        "src/youtube/content.js"
      ],
      "css": [
        "src/youtube/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["src/context-menu/menu.css"], "matches": ["https://*/*"] }],
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
